# 공개 HTTPS 주소에 scheme이나 path 없이 hostname만 넣습니다.
JOBVIS_API_HOST=api.example.com
JOBVIS_TLS_EMAIL=operator@example.com

# 실제 OpenAI Sites 배포의 정확한 HTTPS origin입니다.
JOBVIS_WEB_ORIGIN=https://example.openai.site

JOBVIS_POSTGRES_DB=jobvis
JOBVIS_POSTGRES_USER=jobvis
JOBVIS_POSTGRES_PASSWORD=replace-with-a-long-random-password

# prepare-env.sh가 각각 32바이트 난수로 생성합니다. 예시 값을 운영에 쓰지 않습니다.
JOBVIS_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JOBVIS_TRUSTED_SITE_SECRET=replace-with-at-least-32-random-bytes

# 소형 VM 기본값입니다. 값 변경 시 합계가 VM 메모리보다 충분히 작아야 합니다.
JOBVIS_API_MEMORY_LIMIT=1024m
JOBVIS_POSTGRES_MEMORY_LIMIT=768m
JOBVIS_CADDY_MEMORY_LIMIT=192m

# 외부 연동을 사용할 때만 채웁니다.
JOBVIS_GOOGLE_CLIENT_ID=
JOBVIS_KAKAO_CLIENT_ID=
JOBVIS_GMAIL_CLIENT_ID=
JOBVIS_GMAIL_CLIENT_SECRET=
JOBVIS_MICROSOFT_CLIENT_ID=
JOBVIS_MICROSOFT_CLIENT_SECRET=
JOBVIS_GOOGLE_CALENDAR_CLIENT_ID=
JOBVIS_GOOGLE_CALENDAR_CLIENT_SECRET=
